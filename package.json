{
  "name": "kojima-brewery-order-system",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "setup": "node scripts/setup-local.mjs && npm run db:migrate && npm run db:seed",
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/wrangler.mjs dev --ip 127.0.0.1 --port 8787",
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "smoke": "node scripts/smoke.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/wrangler.mjs d1 migrations apply DB --local",
    "db:seed": "node scripts/wrangler.mjs d1 execute DB --local --file seeds/demo.sql",
    "db:migrate:remote": "node scripts/wrangler.mjs d1 migrations apply DB --remote --env production",
    "deploy:check": "node scripts/check-production.mjs",
    "deploy:admin": "node --use-env-proxy scripts/deploy-admin.mjs",
    "verify:production": "node --use-env-proxy scripts/verify-production.mjs",
    "cloudflare:provision": "node --use-env-proxy scripts/provision-cloudflare.mjs",
    "deploy": "npm run deploy:check && npm run typecheck && npm run test && npm run build && node scripts/wrangler.mjs deploy --env production"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@line/liff": "^2.27.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/vite": "^4.1.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.9.0",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tailwindcss": "^4.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.43.0"
  }
}
